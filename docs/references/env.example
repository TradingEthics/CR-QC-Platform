# ============================================================
# CR QC Platform — Configuration
# Copy this to .env and fill in your values
# ============================================================

# Intercom API
INTERCOM_API_TOKEN=your_intercom_api_token_here
INTERCOM_API_VERSION=2.11

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- AI Scorer -------------------------------------------------
# Which provider scores by default: 'gemini' or 'openrouter'. Override per-run
# with `scoring_worker.py --provider openrouter`. OpenRouter is the workhorse
# while Gemini is on the free tier (20 requests/day); switch to gemini once the
# Gemini project has billing enabled (lifts the cap + unlocks Batch Mode).
SCORING_PROVIDER=openrouter

# Gemini — Google AI Studio API key (aistudio.google.com/apikey).
# NOTE: a Gemini *app* Pro subscription does NOT grant API quota; the key's
# Google Cloud project needs billing enabled to leave the 20/day free tier.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Use Gemini Batch Mode for the scheduled scoring worker: 50% cheaper. Requires
# a billing-enabled (paid) Gemini project — free tier cannot use batch.
GEMINI_USE_BATCH=true

# OpenRouter (openrouter.ai/keys) — OpenAI-compatible, pay-per-use (needs credit).
# OPENROUTER_MODEL is any model slug; DeepSeek V4 Flash is the current pick.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Scoring Config
SCORING_BATCH_SIZE=10
SCORING_MAX_RETRIES=3
SCORING_RETRY_DELAY_SECONDS=5

# Ingestion Config
INGESTION_PAGE_SIZE=50
INGESTION_LOOKBACK_HOURS=6
INGESTION_MAX_PAGES=100

# App
LOG_LEVEL=INFO
TIMEZONE=Asia/Dhaka

# --- Frontend auth (Next.js dashboard) ------------------------
# Google OAuth 2.0 Client (console.cloud.google.com → APIs & Services →
# Credentials). Access is restricted to @nextventures.io accounts in code.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Session encryption secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_secret
# Public base URL of the app (http://localhost:3000 in dev; the Vercel URL in prod)
NEXTAUTH_URL=http://localhost:3000

# --- Refresh pipeline (in-app "Fetch" button + daily Vercel cron) -------------
# Bearer token the Vercel Cron sends to /api/cron/refresh; generate with:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
# Set the SAME value in Vercel env vars. The manual button uses the admin session
# instead, so it does not need this.
CRON_SECRET=your_cron_secret
# Comma-separated Intercom team IDs for the 13 CR inboxes (scopes ingestion).
CR_INBOX_IDS=
# Intercom workspace/app id — builds clickable conversation links.
INTERCOM_APP_ID=

# --- Embedding-based escalation detection (uses GEMINI_API_KEY) ---------------
# Gemini embedding model for cross-agent duplicate / context-match detection.
EMBEDDING_MODEL=text-embedding-004
# Cosine ≥ this between two DIFFERENT agents' replies => Neglected Escalation
# History (customer got the same answer twice). 0.90 is conservative.
ESCALATION_NEGLECT_THRESHOLD=0.90
# Turn on the noisier "Incorrect Escalation Channel/Team" detector (customer
# context vs agent reply). Off by default; calibrate the threshold before use.
ESCALATION_MISMATCH_ENABLED=false
ESCALATION_MISMATCH_THRESHOLD=0.35
