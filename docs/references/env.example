# ============================================================
# CR QC Platform — Configuration
# Copy this to .env and fill in your values
# ============================================================

# Intercom API
INTERCOM_API_TOKEN=your_intercom_api_token_here
INTERCOM_API_VERSION=2.11

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Gemini (AI Scorer)
# Google AI Studio API key — aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Use Gemini Batch Mode for the scheduled scoring worker: 50% cheaper, and
# nothing in the scoring window is latency-sensitive.
GEMINI_USE_BATCH=true

# Scoring Config
SCORING_BATCH_SIZE=10
SCORING_MAX_RETRIES=3
SCORING_RETRY_DELAY_SECONDS=5

# Ingestion Config
INGESTION_PAGE_SIZE=50
INGESTION_LOOKBACK_HOURS=6
INGESTION_MAX_PAGES=100

# App
LOG_LEVEL=INFO
TIMEZONE=Asia/Dhaka
