# ============================================================
# CR QC Platform — Configuration
# Copy this to .env and fill in your values
# ============================================================

# Intercom API
INTERCOM_API_TOKEN=your_intercom_api_token_here
INTERCOM_API_VERSION=2.11

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Groq (Primary AI Scorer)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Fallback AI Scorer)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b:free

# Scoring Config
SCORING_BATCH_SIZE=10
SCORING_MAX_RETRIES=3
SCORING_RETRY_DELAY_SECONDS=5

# Ingestion Config
INGESTION_PAGE_SIZE=50
INGESTION_LOOKBACK_HOURS=6
INGESTION_MAX_PAGES=100

# App
LOG_LEVEL=INFO
TIMEZONE=Asia/Dhaka
